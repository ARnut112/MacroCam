# Copy to .env.local. Leave blank to use the explicit local demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random value for the protected expiration endpoint.
CRON_SECRET=
# At least 32 random characters; server only. Signs order access receipts.
ORDER_ACCESS_SECRET=
# Only enable behind a proxy that overwrites x-forwarded-for (Vercel works automatically).
TRUST_PROXY_HEADERS=false
# Set true only after real QR, policies, catalog and admin are ready.
STORE_CHECKOUT_ENABLED=false
